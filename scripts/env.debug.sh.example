# Debug-machine ASR weight paths. Copy to scripts/env.debug.sh and edit.
#   cp scripts/env.debug.sh.example scripts/env.debug.sh
#   STAGE2_ENV=debug ./scripts/run_stage2_pipeline.sh asr

export QWEN_MODEL_ID="${QWEN_MODEL_ID:-/path/to/debug/Qwen3-ASR-1.7B}"
export FIRERED_ASR_MODEL_DIR="${FIRERED_ASR_MODEL_DIR:-/path/to/debug/FireRedASR2-AED}"
export FIRERED_LID_MODEL_DIR="${FIRERED_LID_MODEL_DIR:-/path/to/debug/FireRedLID}"
export FIRERED_PUNC_MODEL_DIR="${FIRERED_PUNC_MODEL_DIR:-/path/to/debug/FireRedPunc}"
