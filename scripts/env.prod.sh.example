# Production-machine ASR weight paths. Copy to scripts/env.prod.sh and edit.
#   cp scripts/env.prod.sh.example scripts/env.prod.sh
#   STAGE2_ENV=prod ./scripts/run_stage2_pipeline.sh asr

export QWEN_MODEL_ID="${QWEN_MODEL_ID:-/path/to/prod/Qwen3-ASR-1.7B}"
export FIRERED_ASR_MODEL_DIR="${FIRERED_ASR_MODEL_DIR:-/path/to/prod/FireRedASR2-AED}"
export FIRERED_LID_MODEL_DIR="${FIRERED_LID_MODEL_DIR:-/path/to/prod/FireRedLID}"
export FIRERED_PUNC_MODEL_DIR="${FIRERED_PUNC_MODEL_DIR:-/path/to/prod/FireRedPunc}"
